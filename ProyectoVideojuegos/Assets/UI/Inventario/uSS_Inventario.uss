.pantalla-global {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: space-between;
}

.oculto {
    opacity: 0;
    display: flex;
}

.hud-ingame {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 20px;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

.contenedor-barras-hud {
    align-self: flex-start;
    width: 300px;
}

.barra-progreso {
    height: 22px;
    margin-bottom: 8px;
}

.barra-progreso .unity-progress-bar__background {
    background-color: rgba(20, 10, 10, 0.75);
    border-radius: 4px;
    border-width: 1.5px;
    border-color: rgba(100, 80, 60, 0.4);
}

.barra-progreso.vida .unity-progress-bar__progress {
    background-color: rgb(179, 36, 36);
    border-radius: 3px 0 0 3px;
    border-right-width: 1px;
    border-right-color: rgb(255, 77, 77);
}

.barra-progreso.stamina .unity-progress-bar__progress {
    background-color: rgb(26, 98, 163);
    border-radius: 3px 0 0 3px;
    border-right-width: 1px;
    border-right-color: rgb(77, 166, 255);
}

.barra-progreso .unity-progress-bar__title {
    color: rgb(224, 224, 224);
    font-size: 11px;
    -unity-font-style: bold;
}

.barra-progreso-menu {
    flex-grow: 1;
    height: 18px;
}

.barra-progreso-menu .unity-progress-bar__background {
    background-color: rgba(15, 12, 12, 0.9);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(204, 164, 59, 0.3);
}

.barra-progreso-menu.vida .unity-progress-bar__progress {
    background-color: rgb(168, 35, 35);
    border-radius: 2px 0 0 2px;
}

.barra-progreso-menu.stamina .unity-progress-bar__progress {
    background-color: rgb(29, 108, 181);
    border-radius: 2px 0 0 2px;
}

.barra-progreso-menu .unity-progress-bar__title {
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hotbar-hud {
    position: absolute;
    bottom: 60px;
    right: 60px;
    width: 160px;
    height: 160px;
    opacity: 1;
}

.slot-rapido {
    position: absolute;
    width: 60px;
    height: 60px;
    background-color: rgba(20, 15, 15, 0.85);
    border-width: 2px;
    border-color: rgb(74, 21, 21);
    border-radius: 6px;
    rotate: 45deg;
    justify-content: center;
    align-items: center;
}

.slot-rapido.superior {
    top: 0;
    left: 50px;
}

.slot-rapido.izquierdo {
    top: 50px;
    left: 0;
}

.slot-rapido.derecho {
    top: 50px;
    right: 0;
}

.slot-rapido.inferior {
    bottom: 0;
    left: 50px;
}

.icono-item {
    width: 60%;
    height: 60%;
    rotate: -45deg;
}

.contador-cantidad {
    position: absolute;
    bottom: 0;
    right: 1px;
    font-size: 11px;
    color: rgb(255, 255, 255);
    rotate: -45deg;
    -unity-font-style: bold;
}

.menu-inventario {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

.fondo-oscuro {
    position: absolute;
    width: 87%;
    height: 100%;
    background-color: rgba(24, 16, 9, 0.92);
    left: 0;
    border-top-right-radius: 2%;
    border-bottom-right-radius: 2%;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

.contenedor-principal-inventario {
    width: 80%;
    height: 80%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: auto;
    align-content: auto;
    align-self: flex-start;
    margin-left: 5%;
}

.titulo-seccion {
    color: rgb(204, 164, 59);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    letter-spacing: 1px;
}

.columna-izquierda {
    width: 35%;
    height: 100%;
    padding-right: 25px;
}

.seccion-bloque {
    background-color: rgba(25, 20, 20, 0.4);
    border-width: 1px;
    border-color: rgba(204, 164, 59, 0.1);
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 15px;
}

.fila-barra-menu {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.etiqueta-atributo {
    color: rgb(166, 166, 166);
    width: 60px;
    font-size: 12px;
}

.fila-atributo {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 0;
}

.nombre-atributo {
    color: rgb(224, 224, 224);
    font-size: 13px;
}

.valor-atributo {
    color: rgb(204, 164, 59);
    -unity-font-style: bold;
    font-size: 13px;
}

.slot-equipamiento {
    flex-direction: row;
    align-items: center;
    height: 60px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    margin-bottom: 6px;
    padding: 0 10px;
    border-left-color: rgb(77, 32, 112);
    border-right-color: rgb(77, 32, 112);
    border-top-color: rgb(77, 32, 112);
    border-bottom-color: rgb(77, 32, 112);
}

.icono-equipamiento {
    width: 40px;
    height: 40px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
    margin-right: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(54, 65, 83);
    border-right-color: rgb(54, 65, 83);
    border-top-color: rgb(54, 65, 83);
    border-bottom-color: rgb(54, 65, 83);
    position: absolute;
    right: auto;
    left: 15px;
    bottom: auto;
    top: auto;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.texto-equipamiento {
    color: rgb(156, 132, 184);
    font-size: 12px;
    -unity-font-style: bold;
}

.columna-derecha {
    width: 55%;
    height: 100%;
    padding-left: 25px;
    border-left-width: 1px;
    border-color: rgba(204, 164, 59, 0.1);
}

.cuadricula-mochila {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.slot-mochila {
    width: 85px;
    height: 85px;
    background-color: rgba(30, 24, 24, 0.7);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    margin: 8px;
    justify-content: center;
    align-items: center;
}

.pie-pagina-atajos {
    position: absolute;
    bottom: 20px;
    flex-direction: row;
    justify-content: flex-start;
    width: 17%;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    align-items: auto;
    align-self: flex-start;
    margin-left: 5%;
}

.texto-atajo {
    color: rgb(122, 115, 103);
    margin: 0 15px;
    font-size: 12px;
}

.contenedor-slot-iconoEquipamento {
    width: 50px;
    height: 50px;
    background-color: rgb(51, 51, 51);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(65, 55, 40);
    border-right-color: rgb(65, 55, 40);
    border-top-color: rgb(65, 55, 40);
    border-bottom-color: rgb(65, 55, 40);
}

.imagen-fragmento-oculto {
    display: none;
}
.cartel-interaccion {
    position: absolute;
    bottom: 15%; /* Posicionado abajo, ideal para no tapar el centro */
    align-self: center;
    background-color: rgba(18, 12, 8, 0.85); /* Fondo oscuro traslúcido */
    border-width: 1px;
    border-color: rgba(204, 164, 59, 0.4); /* Borde dorado apagado */
    border-radius: 4px;
    padding: 8px 24px;
    transition-property: opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
    opacity: 1;
}

.cartel-oculto {
    opacity: 0;
    display: flex; /* Mantiene el flujo pero invisible para la animación */
}

.texto-cartel {
    color: rgb(215, 200, 175);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
}