<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MenuStyle.uss?fileID=7433441132597879392&amp;guid=e5c1657ab539e88408b6949108ae20f3&amp;type=3#MenuStyle"/>
    <ui:VisualElement name="main" picking-mode="Ignore" class="contenedor" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI_Sprites/Space%20Background.png?fileID=2800000&amp;guid=d0f80962b36360247bff12f90389e5d0&amp;type=3#Space Background&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.63);">
        <ui:VisualElement name="T_Fragments" picking-mode="Ignore" class="tFragments" style="flex-grow: 1;">
            <ui:VisualElement name="textmain" class="textmain" style="flex-grow: 1;">
                <ui:Label text="FRAGMENTS OF GUILTY" name="fragments" class="fragmentsText" style="font-size: 90%; position: absolute; align-items: center; justify-content: center; max-width: none; max-height: none; top: 40%; right: auto; left: auto; bottom: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/CinzelDecorative-Bold.otf?fileID=12800000&amp;guid=7d4cfba4f27ffa146b0815f408c8393e&amp;type=3#CinzelDecorative-Bold&quot;); color: rgb(231, 231, 231); -unity-text-align: middle-center; -unity-font-style: normal; -unity-text-auto-size: none; width: 100%; height: 50%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="containerbuttons" picking-mode="Ignore" class="containerbuttons">
            <ui:Button text="JUGAR" name="Play" class="button-p" style="font-size: 20px;"/>
            <ui:Button text="OPCIONES" name="Options" class="button-p" style="font-size: 20px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MenuOpciones" class="panel-opciones oculto">
            <ui:VisualElement name="VisualElement" class="opciones-header">
                <ui:Label text="OPCIONES" class="texto-dorado titulo-seccion"/>
                <ui:Button name="BtnCerrarTop" text="X" class="btn-cerrar-x"/>
            </ui:VisualElement>
            <ui:VisualElement name="DondeSlider" class="seccion-bloque">
                <ui:Label text="AUDIO" class="texto-dorado subtitulo-seccion"/>
                <ui:VisualElement class="fila-slider">
                    <ui:Label text="Volumen de Musica" class="texto-blanco"/>
                    <ui:Slider name="SliderMusica" value="67" start-value="0" end-value="100" class="slider-personalizado"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ContenedorControles" class="seccion-bloque" style="flex-grow: 1;">
                <ui:Label text="CONTROLES" class="texto-dorado subtitulo-seccion"/>
                <ui:VisualElement class="grid-controles">
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Mover Izquierda" class="texto-blanco"/>
                        <ui:Label text="A" class="tecla-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Mover Derecha" class="texto-blanco"/>
                        <ui:Label text="D" class="tecla-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Saltar" class="texto-blanco"/>
                        <ui:Label text="SPACE" class="tecla-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Recolectar Items" class="texto-blanco"/>
                        <ui:Label text="R" class="tecla-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Atacar" class="texto-blanco"/>
                        <ui:Label text="Q" class="tecla-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Usar Magia" class="texto-blanco"/>
                        <ui:Label text="E" class="tecla-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Inventario" class="texto-blanco"/>
                        <ui:Label text="TAB" class="tecla-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="control-item">
                        <ui:Label text="Opciones" class="texto-blanco"/>
                        <ui:Label text="ESC" class="tecla-box"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="BtnVolver" text="VOLVER AL MENU" class="btn-volver-menu"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
